NODE_ENV=production

# URL pública HTTPS do frontend (domínio oficial ou URL temporária do Coolify, SEM barra no final)
FRONTEND_ORIGIN=https://homol-conselhonext.falavinha.com.br

TRUST_PROXY=loopback,linklocal,uniquelocal

# Gere uma chave nova (>= 32 chars) com:
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
JWT_SECRET=substitua-por-uma-chave-gerada-com-o-comando-acima
JWT_EXPIRES_IN=24h

# String de conexão interna do PostgreSQL (copiar "Internal Postgres URL" no Coolify)
DATABASE_URL=postgresql://usuario:senha@host_interno_do_coolify:porta/nome_do_banco?schema=public&connection_limit=50&pool_timeout=30

# --- Envio de e-mails (SMTP — necessário apenas na branch minigames-prod) ---
# Ex.: smtp.office365.com (Outlook/Microsoft 365) ou smtp.gmail.com (Google Workspace)
SMTP_HOST=smtp.office365.com
# Porta comum: 587 (STARTTLS) ou 465 (SSL/TLS implícito)
SMTP_PORT=587
# false para porta 587 | true para porta 465
SMTP_SECURE=false
# E-mail da conta remetente que vai autenticar no servidor SMTP
SMTP_USER=
# Senha da conta ou Senha de App (se tiver 2FA/MFA)
SMTP_PASS=
# Nome de exibição livre, mas o e-mail entre <...> precisa ser o mesmo do SMTP_USER
SMTP_FROM="Conselho Next Falavinha <no-reply@falavinha.com.br>"