PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5174

# Configuração individual do PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=jogofalavinha

# String de conexão consumida pelo Prisma (aponta para porta 5433 quando executado no host)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/jogofalavinha?schema=public"
