PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5174
TRUST_PROXY=loopback,linklocal,uniquelocal
JWT_SECRET="dev-falavinha-next-jwt-secret-change-in-prod"
JWT_EXPIRES_IN="24h"

# Configuração individual do PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=jogofalavinha

# String de conexão consumida pelo Prisma (aponta para porta 5433 quando executado no host)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/jogofalavinha?schema=public&connection_limit=50&pool_timeout=30"
