    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "6.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
