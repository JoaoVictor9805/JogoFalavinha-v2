generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Colaborador / Jogador cadastrado no sistema
model Jogador {
  id           String    @id @default(uuid())
  nome         String
  email        String    @unique
  unidade      String
  setor        String
  genero       String    @default("masculino") // "masculino" | "feminino"
  senha        String?   // Senha com hash bcrypt
  tokenVersion Int       @default(0) @map("token_version") // Incrementado no logout para revogação real de JWT
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  partidas     Partida[]

  @@map("jogadores")
  @@index([email])
  @@index([setor])
  @@index([unidade])
}

// Sessão / Partida do colaborador
model Partida {
  id                   String                @id @default(uuid())
  jogadorId            String                @map("jogador_id")
  jogador              Jogador               @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
  status               String                @default("EM_ANDAMENTO") // "EM_ANDAMENTO" | "CONCLUIDA" | "CANCELADA"
  iniciadoEm           DateTime              @default(now()) @map("iniciado_em")
  cronometroIniciadoEm DateTime?             @map("cronometro_iniciado_em")
  ultimoSyncEm         DateTime?             @map("ultimo_sync_em")
  finalizadoEm         DateTime?             @map("finalizado_em")
  pausaMsAcumulados    Int                   @default(0) @map("pausa_ms_acumulados")
  pausadoDesde         DateTime?             @map("pausado_desde")
  pausaMaximaAte       DateTime?             @map("pausa_maxima_ate")
  segundosReais        Int                   @default(0) @map("segundos_reais")
  segundosPenalidade   Int                   @default(0) @map("segundos_penalidade")
  segundosBonus        Int                   @default(0) @map("segundos_bonus")
  segundosTotais       Int                   @default(0) @map("segundos_totais")
  totalErros           Int                   @default(0) @map("total_erros")
  comboAtual           Int                   @default(0) @map("combo_atual")
  totalCombos          Int                   @default(0) @map("total_combos")
  etapaAtual           Int                   @default(0) @map("etapa_atual") // 0 a 7 (progresso no labirinto)
  membrosConcluidos    Int[]                 @default([]) @map("membros_concluidos") // IDs dos membros já aprovados
  tentativas           Tentativa[]
  opcoesDesabilitadas  OpcaoDesabilitada[]
  bloqueios            BloqueioConselheiro[]
  criadoEm             DateTime              @default(now()) @map("criado_em")
  atualizadoEm         DateTime              @updatedAt @map("atualizado_em")

  // ATENÇÃO (Migrations futuras): existe um índice único parcial customizado no PostgreSQL
  // ("partidas_unica_em_andamento_por_jogador" WHERE status = 'EM_ANDAMENTO'), criado na migration
  // 20261119163500_add_unique_active_partida_index. Como o Prisma não expressa índices parciais
  // neste arquivo, SEMPRE revise migrations geradas por `prisma migrate dev` para não incluir DROP INDEX.
  @@map("partidas")
  @@index([jogadorId])
  @@index([jogadorId, status])
  @@index([status])
  @@index([segundosTotais])
}

// Desafio oficial (um dos 7 membros do Conselho Next)
model Desafio {
  id                Int            @id // 1 a 7
  codigo            String         // M1 a M7
  nome              String         // André / Sapo, Ramon, Vanessa, etc.
  cargo             String
  rotuloCurto       String         @map("rotulo_curto")
  posicaoMesa       String         @map("posicao_mesa")
  gradienteAvatar   String         @map("gradiente_avatar")
  corBorda          String         @map("cor_borda")
  corBrilho         String         @map("cor_brilho")
  corBadge          String         @map("cor_badge")
  tipo              String         @default("multiple_choice")
  saudacao          String         @db.Text
  pergunta          String         @db.Text
  mensagemAprovacao String         @map("mensagem_aprovacao") @db.Text
  opcoes            OpcaoDesafio[]
  tentativas        Tentativa[]

  @@map("desafios")
}

// Alternativas de cada desafio (o campo 'correta' NUNCA é enviado ao frontend)
model OpcaoDesafio {
  id        String   @id @default(uuid())
  desafioId Int      @map("desafio_id")
  desafio   Desafio  @relation(fields: [desafioId], references: [id], onDelete: Cascade)
  opcaoId   String   @map("opcao_id") // 'a', 'b', 'c', 'd'
  rotulo    String   // 'a)', 'b)', etc.
  texto     String   @db.Text
  correta   Boolean  // Gabarito protegido no banco de dados

  @@unique([desafioId, opcaoId])
  @@index([desafioId])
  @@map("opcoes_desafio")
}

// Opções desabilitadas após erros cometidos em uma partida
model OpcaoDesabilitada {
  id        String   @id @default(uuid())
  partidaId String   @map("partida_id")
  partida   Partida  @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  membroId  Int      @map("membro_id")
  opcaoId   String   @map("opcao_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@unique([partidaId, membroId, opcaoId])
  @@index([partidaId])
  @@map("opcoes_desabilitadas")
}

// Bloqueio temporário (10s) aplicado quando o jogador erra 3x o mesmo conselheiro
model BloqueioConselheiro {
  id             String    @id @default(uuid())
  partidaId      String    @map("partida_id")
  partida        Partida   @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  membroId       Int       @map("membro_id")
  bloqueadoAte   DateTime? @map("bloqueado_ate")
  vezesBloqueado Int       @default(0) @map("vezes_bloqueado")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  @@unique([partidaId, membroId])
  @@index([partidaId])
  @@map("bloqueios_conselheiros")
}

// Log e auditoria de cada tentativa de resposta do jogador
model Tentativa {
  id                 String   @id @default(uuid())
  partidaId          String   @map("partida_id")
  partida            Partida  @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  desafioId          Int      @map("desafio_id")
  desafio            Desafio  @relation(fields: [desafioId], references: [id])
  opcaoSelecionada   String   @map("opcao_selecionada") // 'a', 'b', 'c', 'd'
  acertou            Boolean
  penalidadeAplicada Int      @default(0) @map("penalidade_aplicada") // 0 ou 5
  criadoEm           DateTime @default(now()) @map("criado_em")

  @@index([partidaId])
  @@index([desafioId])
  @@index([partidaId, acertou, criadoEm])
  @@index([partidaId, desafioId, acertou])
  @@map("tentativas")
}
