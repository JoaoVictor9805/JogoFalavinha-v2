# ==============================================================================
# Variáveis de Ambiente de Homologação (Preencher no painel do Coolify)
# NUNCA coloque valores reais dentro do repositório Git.
# ==============================================================================

# URL oficial HTTPS do ambiente de homologação (sem barra no final)
FRONTEND_ORIGIN=https://homol-conselhonext.falavinha.com.br

# Segredo forte EXCLUSIVO de homologação (>= 32 caracteres aleatórios, diferente de prod)
# Exemplo para gerar no terminal: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=substitua-por-uma-chave-aleatoria-com-mais-de-32-caracteres
JWT_EXPIRES_IN=24h

# Confia apenas no proxy reverso na rede privada (Traefik do Coolify + Nginx interno)
TRUST_PROXY=loopback,linklocal,uniquelocal

# Conexão com o PostgreSQL de homologação (banco exclusivo, separado de produção)
DATABASE_URL=postgresql://falavinha_homol:senha_forte@host_postgres_homol:5432/jogofalavinha_homol?schema=public&connection_limit=50&pool_timeout=30

# ------------------------------------------------------------------------------
# Opcional: preencha abaixo SOMENTE se for subir o PostgreSQL dentro do próprio
# docker-compose.yml (ativando o profile "db").
# ------------------------------------------------------------------------------

# COMPOSE_PROFILES=db
# POSTGRES_USER=falavinha_homol
# # node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# POSTGRES_PASSWORD=substitua-por-uma-senha-forte
# POSTGRES_DB=jogofalavinha_homol
