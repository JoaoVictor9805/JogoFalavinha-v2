# ==============================================================================
# Variáveis de Ambiente de Produção (Preencher no painel do Coolify)
# ==============================================================================

# URL oficial HTTPS por onde os colaboradores vão acessar o jogo
FRONTEND_ORIGIN=https://conselhonext.falavinha.com.br

# Segredo forte para assinatura dos cookies de sessão (>= 32 caracteres aleatórios)
# Exemplo para gerar no terminal: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=substitua-por-uma-chave-aleatoria-com-mais-de-32-caracteres
JWT_EXPIRES_IN=24h

# Confia apenas no proxy reverso na rede privada (Traefik do Coolify + Nginx interno)
TRUST_PROXY=loopback,linklocal,uniquelocal

# Conexão com o PostgreSQL de produção (criado no Coolify ou servidor externo)
DATABASE_URL=postgresql://usuario:senha_forte@host_postgres:5432/jogofalavinha?schema=public

# ------------------------------------------------------------------------------
# Opcional: preencha abaixo SOMENTE se for subir o PostgreSQL dentro do próprio
# docker-compose.prod.yml (ativando o profile "db").
# ------------------------------------------------------------------------------

COMPOSE_PROFILES=db
POSTGRES_USER=falavinha_prod
POSTGRES_PASSWORD=substitua-por-uma-senha-forte
POSTGRES_DB=jogofalavinha