# ==============================================================================
# Variáveis de Ambiente de Produção (Preencher no painel do Coolify)
# NUNCA coloque valores reais de produção dentro do repositório Git.
# ==============================================================================

# URL oficial HTTPS por onde os colaboradores vão acessar o jogo
FRONTEND_ORIGIN=https://conselhonext.falavinha.com.br

# Segredo forte para assinatura dos cookies de sessão (>= 32 caracteres aleatórios)
# Exemplo para gerar no terminal: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=substitua-por-uma-chave-aleatoria-com-mais-de-32-caracteres
JWT_EXPIRES_IN=24h

# Confia apenas no proxy reverso na rede privada (Traefik do Coolify + Nginx interno)
TRUST_PROXY=loopback,linklocal,uniquelocal

# Conexão com o PostgreSQL de produção (criado no Coolify ou servidor externo)
DATABASE_URL=postgresql://usuario:senha_forte@host_postgres:5432/jogofalavinha?schema=public&connection_limit=50&pool_timeout=30

# ------------------------------------------------------------------------------
# Envio de E-mails (SMTP corporativo Microsoft 365 / Outlook)
# Basta preencher estas variáveis no Coolify assim que o TI liberar a conta.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@falavinha.com.br
SMTP_PASS=senha_ou_senha_de_app_da_conta
# No Microsoft 365, o endereço em SMTP_FROM deve ser o mesmo de SMTP_USER (ou ter permissão Send As)
SMTP_FROM="Conselho Next Falavinha <no-reply@falavinha.com.br>"
# Opcional: segredo extra para HMAC dos códigos OTP (se omitido, deriva com segurança do JWT_SECRET)
OTP_SECRET=

# ------------------------------------------------------------------------------
# Opcional: preencha abaixo SOMENTE se for subir o PostgreSQL dentro do próprio
# docker-compose.yml (ativando o profile "db").
# ------------------------------------------------------------------------------

COMPOSE_PROFILES=db
POSTGRES_USER=questionario_prod
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=substitua-por-uma-senha-forte
POSTGRES_DB=jogofalavinha
